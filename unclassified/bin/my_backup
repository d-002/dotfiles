#!/bin/sh

rsync -av --delete --delete-excluded --progress "$HOME/Documents/Programming/" "/mnt/nas/Sauvegardes/PC/Documents/Programming" --exclude-from "$HOME/.local/bin/.backup_rsync_ignore"
rsync -av --delete --delete-excluded --progress "$HOME/testing/" "/mnt/nas/Sauvegardes/PC/testing" --exclude-from "$HOME/.local/bin/.backup_rsync_ignore"

cd /mnt/nas/Sauvegardes/GitHub
for dir in *; do
    cd "$dir"
    git pull
    cd - >/dev/null
done

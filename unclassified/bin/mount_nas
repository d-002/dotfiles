read -p "Enter subpath: " subpath
read -p "Enter username: " username
read -p "Enter password (will be visible sry): " password

if [ -z "$username" ]; then
    echo "Aborting: empty username."
    exit 1
fi

sudo mount --mkdir -t cifs "//192.168.1.2/$subpath" /mnt/nas -o "username=$username,password=$password,file_mode=0777,dir_mode=0777,uid=1000,gid=1001"
